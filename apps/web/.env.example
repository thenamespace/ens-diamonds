# Coffer web — environment template. Copy to .env.local for dev.
# NEVER commit .env.local (it holds live tokens). See docs/RUNBOOK.md for the
# per-deployment env matrix and the one-build-per-chain rule.

# ── Chain selection (build-time; inlined into the bundle) ────────────────────
# "sepolia" (default) or "mainnet". Picks every on-chain address + the
# registration flow (sepolia = free/instant premigration; mainnet =
# paid commit-reveal). ONE BUILD PER CHAIN — you cannot flip this at runtime.
NEXT_PUBLIC_APP_CHAIN=sepolia

# ── Escrow (build-time; inlined) ─────────────────────────────────────────────
# The CofferEscrow for THIS deployment. Optional on sepolia (a default is baked
# in: 0x5229b09a1f1EC16E69545bAE19E3b2A453a3Ae39). REQUIRED on mainnet — a
# mainnet build never falls back to the Sepolia escrow; leaving it unset builds
# fine but every escrow-backed API route then 500s (assertEscrowConfigured).
NEXT_PUBLIC_ESCROW_ADDRESS=

# ── App RPC (build-time; inlined) ────────────────────────────────────────────
# Override the public fallback RPC for the app chain. Optional; a public
# publicnode endpoint is used if unset. Use your own (Alchemy/Infura) in prod
# to avoid rate limits and archive-range rejections.
NEXT_PUBLIC_RPC_URL=
# Legacy Sepolia-only alias, honored ONLY on sepolia builds. Prefer NEXT_PUBLIC_RPC_URL.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# ── Mainnet read RPC (server-only; both chains) ──────────────────────────────
# Used for ENS price/availability reads that ALWAYS hit Ethereum mainnet (the
# live-price box, name resolution), regardless of NEXT_PUBLIC_APP_CHAIN.
# Optional (public fallback), but set your own for reliability.
MAINNET_RPC_URL=

# ── WalletConnect (build-time; inlined) ──────────────────────────────────────
# Project id from cloud.reown.com. OPTIONAL: without it, WalletConnect
# (mobile/QR) is disabled and only injected (MetaMask/Rabby) + Coinbase wallets
# are offered. Set it in prod to support mobile wallets.
NEXT_PUBLIC_WC_PROJECT_ID=

# ── Sessions (server-only) ───────────────────────────────────────────────────
# iron-session password for SIWE cookies. REQUIRED in prod. Must be >= 32 chars.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# ── KV / Upstash Redis (server-only) ─────────────────────────────────────────
# Coordination store: SIWE nonces, pool visibility/watching, rate limiter,
# commit-reveal secrets + Safe signatures. REQUIRED for those features.
# KV_REST_API_* (Vercel KV) is tried first, then UPSTASH_REDIS_REST_* — set
# EITHER pair. USE A SEPARATE DATABASE PER DEPLOYMENT (sepolia vs mainnet must
# not share a KV — pool ids/secrets would collide across chains).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# or, equivalently (Vercel KV naming):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── ENS subgraph (server-only) ───────────────────────────────────────────────
# The Graph gateway API key for ENS discovery/search. Required for the discover
# feed. Get one at thegraph.com/studio.
GRAPH_API_KEY=
