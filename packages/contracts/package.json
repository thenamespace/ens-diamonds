{
  "name": "@ens-diamonds/contracts",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "forge build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "clean": "forge clean",
    "format": "forge fmt",
    "format:check": "forge fmt --check",
    "lint": "forge fmt --check && forge lint",
    "snapshot": "forge snapshot",
    "test": "forge test",
    "test:coverage": "forge coverage -D never --report summary",
    "test:fuzz": "forge test --match-path 'test/fuzz/*.t.sol'",
    "test:gas": "FOUNDRY_PROFILE=gas forge test",
    "test:integration": "forge test --match-path 'test/integration/*.t.sol'",
    "test:invariant": "forge test --match-path 'test/invariant/*.t.sol'",
    "test:unit": "forge test --match-path 'test/unit/*.t.sol'",
    "typecheck": "forge build"
  }
}
